{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "type": "Object",
      "defaultValue": {}
    },
    "keyVaultName": {
      "type": "String",
      "defaultValue": "kv-datamigration-poc"
    },
    "storageAccountName": {
      "type": "String",
      "defaultValue": "stadatamigrationpoc"
    },
    "storageContainerName": {
      "type": "String",
      "defaultValue": "schema-discovery-logs"
    },
    "retryPolicy_maxCount": {
      "type": "Int",
      "defaultValue": 3
    },
    "retryPolicy_intervalSeconds": {
      "type": "Int",
      "defaultValue": 30
    }
  },
  "triggers": {
    "manual": {
      "type": "Request",
      "kind": "Http",
      "inputs": {
        "schema": {
          "type": "object",
          "properties": {
            "requestId": {
              "type": "string",
              "description": "Unique identifier for this discovery request"
            },
            "sourceDbType": {
              "type": "string",
              "enum": [
                "Oracle",
                "SQLServer"
              ],
              "description": "Type of source database"
            },
            "connectionKeyVaultSecret": {
              "type": "string",
              "description": "Key Vault secret name containing the source DB connection string"
            },
            "schemaFilter": {
              "type": "string",
              "description": "Optional schema/owner filter (e.g. 'dbo' or 'HR')"
            },
            "tableFilter": {
              "type": "string",
              "description": "Optional comma-separated table names to discover. Empty means all."
            }
          },
          "required": [
            "requestId",
            "sourceDbType",
            "connectionKeyVaultSecret"
          ]
        },
        "method": "POST"
      },
      "operationOptions": "EnableSchemaValidation"
    }
  },
  "actions": {
    "Initialize_DiscoveryResult": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "discoveryResult",
            "type": "object",
            "value": {
              "requestId": "@{triggerBody()?['requestId']}",
              "sourceDbType": "@{triggerBody()?['sourceDbType']}",
              "status": "IN_PROGRESS",
              "tables": [],
              "errors": [],
              "discoveredAt": "@{utcNow()}"
            }
          }
        ]
      },
      "runAfter": {}
    },
    "Initialize_ErrorList": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "errorList",
            "type": "array",
            "value": []
          }
        ]
      },
      "runAfter": {
        "Initialize_DiscoveryResult": [
          "Succeeded"
        ]
      }
    },
    "Initialize_TableList": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "tableList",
            "type": "array",
            "value": []
          }
        ]
      },
      "runAfter": {
        "Initialize_ErrorList": [
          "Succeeded"
        ]
      }
    },
    "Get_Connection_String_From_KeyVault": {
      "type": "Http",
      "inputs": {
        "method": "GET",
        "uri": "https://@{parameters('keyVaultName')}.vault.azure.net/secrets/@{triggerBody()?['connectionKeyVaultSecret']}?api-version=7.4",
        "authentication": {
          "type": "ManagedServiceIdentity",
          "audience": "https://vault.azure.net"
        }
      },
      "runAfter": {
        "Initialize_TableList": [
          "Succeeded"
        ]
      },
      "runtimeConfiguration": {
        "secureData": {
          "properties": [
            "outputs"
          ]
        }
      },
      "retryPolicy": {
        "type": "fixed",
        "count": "@parameters('retryPolicy_maxCount')",
        "interval": "PT@{parameters('retryPolicy_intervalSeconds')}S"
      }
    },
    "Switch_On_DbType": {
      "type": "Switch",
      "expression": "@triggerBody()?['sourceDbType']",
      "cases": {
        "Oracle": {
          "case": "Oracle",
          "actions": {
            "Oracle_Query_Tables": {
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['oracle']['connectionId']"
                  }
                },
                "method": "post",
                "path": "/datasets/default/query/oracle",
                "body": {
                  "query": "SELECT t.TABLE_NAME, t.NUM_ROWS, t.LAST_ANALYZED, t.TABLESPACE_NAME FROM ALL_TABLES t WHERE t.OWNER = NVL('@{triggerBody()?['schemaFilter']}', t.OWNER) AND t.TABLE_NAME NOT LIKE 'SYS%' AND t.TABLE_NAME NOT LIKE 'BIN$%' ORDER BY t.TABLE_NAME"
                }
              },
              "runAfter": {},
              "retryPolicy": {
                "type": "fixed",
                "count": "@parameters('retryPolicy_maxCount')",
                "interval": "PT@{parameters('retryPolicy_intervalSeconds')}S"
              }
            },
            "Oracle_For_Each_Table": {
              "type": "Foreach",
              "foreach": "@body('Oracle_Query_Tables')?['resultSets']?['Table1']",
              "actions": {
                "Oracle_Query_Columns": {
                  "type": "ApiConnection",
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['oracle']['connectionId']"
                      }
                    },
                    "method": "post",
                    "path": "/datasets/default/query/oracle",
                    "body": {
                      "query": "SELECT c.COLUMN_NAME, c.DATA_TYPE, c.DATA_LENGTH, c.DATA_PRECISION, c.DATA_SCALE, c.NULLABLE, c.DATA_DEFAULT, c.CHAR_LENGTH FROM ALL_TAB_COLUMNS c WHERE c.TABLE_NAME = '@{items('Oracle_For_Each_Table')?['TABLE_NAME']}' AND c.OWNER = NVL('@{triggerBody()?['schemaFilter']}', c.OWNER) ORDER BY c.COLUMN_ID"
                    }
                  },
                  "runAfter": {}
                },
                "Oracle_Query_Constraints": {
                  "type": "ApiConnection",
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['oracle']['connectionId']"
                      }
                    },
                    "method": "post",
                    "path": "/datasets/default/query/oracle",
                    "body": {
                      "query": "SELECT ac.CONSTRAINT_NAME, ac.CONSTRAINT_TYPE, acc.COLUMN_NAME, ac.R_CONSTRAINT_NAME, ac.STATUS, ac.SEARCH_CONDITION FROM ALL_CONSTRAINTS ac JOIN ALL_CONS_COLUMNS acc ON ac.CONSTRAINT_NAME = acc.CONSTRAINT_NAME AND ac.OWNER = acc.OWNER WHERE ac.TABLE_NAME = '@{items('Oracle_For_Each_Table')?['TABLE_NAME']}' AND ac.OWNER = NVL('@{triggerBody()?['schemaFilter']}', ac.OWNER) ORDER BY ac.CONSTRAINT_TYPE, ac.CONSTRAINT_NAME"
                    }
                  },
                  "runAfter": {}
                },
                "Oracle_Query_Indexes": {
                  "type": "ApiConnection",
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['oracle']['connectionId']"
                      }
                    },
                    "method": "post",
                    "path": "/datasets/default/query/oracle",
                    "body": {
                      "query": "SELECT ai.INDEX_NAME, ai.INDEX_TYPE, ai.UNIQUENESS, aic.COLUMN_NAME, aic.COLUMN_POSITION FROM ALL_INDEXES ai JOIN ALL_IND_COLUMNS aic ON ai.INDEX_NAME = aic.INDEX_NAME AND ai.OWNER = aic.INDEX_OWNER WHERE ai.TABLE_NAME = '@{items('Oracle_For_Each_Table')?['TABLE_NAME']}' AND ai.OWNER = NVL('@{triggerBody()?['schemaFilter']}', ai.OWNER) ORDER BY ai.INDEX_NAME, aic.COLUMN_POSITION"
                    }
                  },
                  "runAfter": {}
                },
                "Oracle_Build_Table_Object": {
                  "type": "Compose",
                  "inputs": {
                    "tableName": "@{items('Oracle_For_Each_Table')?['TABLE_NAME']}",
                    "rowCount": "@{items('Oracle_For_Each_Table')?['NUM_ROWS']}",
                    "lastAnalyzed": "@{items('Oracle_For_Each_Table')?['LAST_ANALYZED']}",
                    "tablespace": "@{items('Oracle_For_Each_Table')?['TABLESPACE_NAME']}",
                    "columns": "@body('Oracle_Query_Columns')?['resultSets']?['Table1']",
                    "constraints": "@body('Oracle_Query_Constraints')?['resultSets']?['Table1']",
                    "indexes": "@body('Oracle_Query_Indexes')?['resultSets']?['Table1']"
                  },
                  "runAfter": {
                    "Oracle_Query_Columns": [
                      "Succeeded"
                    ],
                    "Oracle_Query_Constraints": [
                      "Succeeded"
                    ],
                    "Oracle_Query_Indexes": [
                      "Succeeded"
                    ]
                  }
                },
                "Oracle_Append_Table": {
                  "type": "AppendToArrayVariable",
                  "inputs": {
                    "name": "tableList",
                    "value": "@outputs('Oracle_Build_Table_Object')"
                  },
                  "runAfter": {
                    "Oracle_Build_Table_Object": [
                      "Succeeded"
                    ]
                  }
                },
                "Oracle_Log_Table_Error": {
                  "type": "AppendToArrayVariable",
                  "inputs": {
                    "name": "errorList",
                    "value": {
                      "table": "@{items('Oracle_For_Each_Table')?['TABLE_NAME']}",
                      "error": "Failed to query columns, constraints, or indexes",
                      "timestamp": "@{utcNow()}"
                    }
                  },
                  "runAfter": {
                    "Oracle_Build_Table_Object": [
                      "Failed",
                      "TimedOut"
                    ]
                  }
                }
              },
              "runAfter": {
                "Oracle_Query_Tables": [
                  "Succeeded"
                ]
              },
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 5
                }
              }
            }
          }
        },
        "SQLServer": {
          "case": "SQLServer",
          "actions": {
            "SQL_Query_Tables": {
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['sql']['connectionId']"
                  }
                },
                "method": "post",
                "path": "/v2/datasets/@{encodeURIComponent(encodeURIComponent('default'))}/query/sql",
                "body": {
                  "query": "SELECT t.TABLE_SCHEMA, t.TABLE_NAME, p.rows AS ROW_COUNT, t.TABLE_TYPE FROM INFORMATION_SCHEMA.TABLES t LEFT JOIN sys.partitions p ON OBJECT_ID(t.TABLE_SCHEMA + '.' + t.TABLE_NAME) = p.object_id AND p.index_id IN (0, 1) WHERE t.TABLE_TYPE = 'BASE TABLE' AND t.TABLE_SCHEMA = COALESCE('@{triggerBody()?['schemaFilter']}', t.TABLE_SCHEMA) ORDER BY t.TABLE_SCHEMA, t.TABLE_NAME"
                }
              },
              "runAfter": {},
              "retryPolicy": {
                "type": "fixed",
                "count": "@parameters('retryPolicy_maxCount')",
                "interval": "PT@{parameters('retryPolicy_intervalSeconds')}S"
              }
            },
            "SQL_For_Each_Table": {
              "type": "Foreach",
              "foreach": "@body('SQL_Query_Tables')?['resultSets']?['Table1']",
              "actions": {
                "SQL_Query_Columns": {
                  "type": "ApiConnection",
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['sql']['connectionId']"
                      }
                    },
                    "method": "post",
                    "path": "/v2/datasets/@{encodeURIComponent(encodeURIComponent('default'))}/query/sql",
                    "body": {
                      "query": "SELECT c.COLUMN_NAME, c.DATA_TYPE, c.CHARACTER_MAXIMUM_LENGTH, c.NUMERIC_PRECISION, c.NUMERIC_SCALE, c.IS_NULLABLE, c.COLUMN_DEFAULT, c.ORDINAL_POSITION, COLUMNPROPERTY(OBJECT_ID(c.TABLE_SCHEMA + '.' + c.TABLE_NAME), c.COLUMN_NAME, 'IsIdentity') AS IS_IDENTITY FROM INFORMATION_SCHEMA.COLUMNS c WHERE c.TABLE_NAME = '@{items('SQL_For_Each_Table')?['TABLE_NAME']}' AND c.TABLE_SCHEMA = '@{items('SQL_For_Each_Table')?['TABLE_SCHEMA']}' ORDER BY c.ORDINAL_POSITION"
                    }
                  },
                  "runAfter": {}
                },
                "SQL_Query_Constraints": {
                  "type": "ApiConnection",
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['sql']['connectionId']"
                      }
                    },
                    "method": "post",
                    "path": "/v2/datasets/@{encodeURIComponent(encodeURIComponent('default'))}/query/sql",
                    "body": {
                      "query": "SELECT tc.CONSTRAINT_NAME, tc.CONSTRAINT_TYPE, kcu.COLUMN_NAME, ccu.TABLE_NAME AS REFERENCED_TABLE, ccu.COLUMN_NAME AS REFERENCED_COLUMN FROM INFORMATION_SCHEMA.TABLE_CONSTRAINTS tc JOIN INFORMATION_SCHEMA.KEY_COLUMN_USAGE kcu ON tc.CONSTRAINT_NAME = kcu.CONSTRAINT_NAME AND tc.TABLE_SCHEMA = kcu.TABLE_SCHEMA LEFT JOIN INFORMATION_SCHEMA.CONSTRAINT_COLUMN_USAGE ccu ON tc.CONSTRAINT_NAME = ccu.CONSTRAINT_NAME AND tc.CONSTRAINT_TYPE = 'FOREIGN KEY' WHERE tc.TABLE_NAME = '@{items('SQL_For_Each_Table')?['TABLE_NAME']}' AND tc.TABLE_SCHEMA = '@{items('SQL_For_Each_Table')?['TABLE_SCHEMA']}' ORDER BY tc.CONSTRAINT_TYPE, tc.CONSTRAINT_NAME"
                    }
                  },
                  "runAfter": {}
                },
                "SQL_Query_Indexes": {
                  "type": "ApiConnection",
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['sql']['connectionId']"
                      }
                    },
                    "method": "post",
                    "path": "/v2/datasets/@{encodeURIComponent(encodeURIComponent('default'))}/query/sql",
                    "body": {
                      "query": "SELECT i.name AS INDEX_NAME, i.type_desc AS INDEX_TYPE, i.is_unique AS IS_UNIQUE, i.is_primary_key AS IS_PRIMARY_KEY, COL_NAME(ic.object_id, ic.column_id) AS COLUMN_NAME, ic.key_ordinal AS COLUMN_POSITION FROM sys.indexes i JOIN sys.index_columns ic ON i.object_id = ic.object_id AND i.index_id = ic.index_id WHERE i.object_id = OBJECT_ID('@{items('SQL_For_Each_Table')?['TABLE_SCHEMA']}.@{items('SQL_For_Each_Table')?['TABLE_NAME']}') ORDER BY i.name, ic.key_ordinal"
                    }
                  },
                  "runAfter": {}
                },
                "SQL_Build_Table_Object": {
                  "type": "Compose",
                  "inputs": {
                    "tableSchema": "@{items('SQL_For_Each_Table')?['TABLE_SCHEMA']}",
                    "tableName": "@{items('SQL_For_Each_Table')?['TABLE_NAME']}",
                    "rowCount": "@{items('SQL_For_Each_Table')?['ROW_COUNT']}",
                    "tableType": "@{items('SQL_For_Each_Table')?['TABLE_TYPE']}",
                    "columns": "@body('SQL_Query_Columns')?['resultSets']?['Table1']",
                    "constraints": "@body('SQL_Query_Constraints')?['resultSets']?['Table1']",
                    "indexes": "@body('SQL_Query_Indexes')?['resultSets']?['Table1']"
                  },
                  "runAfter": {
                    "SQL_Query_Columns": [
                      "Succeeded"
                    ],
                    "SQL_Query_Constraints": [
                      "Succeeded"
                    ],
                    "SQL_Query_Indexes": [
                      "Succeeded"
                    ]
                  }
                },
                "SQL_Append_Table": {
                  "type": "AppendToArrayVariable",
                  "inputs": {
                    "name": "tableList",
                    "value": "@outputs('SQL_Build_Table_Object')"
                  },
                  "runAfter": {
                    "SQL_Build_Table_Object": [
                      "Succeeded"
                    ]
                  }
                },
                "SQL_Log_Table_Error": {
                  "type": "AppendToArrayVariable",
                  "inputs": {
                    "name": "errorList",
                    "value": {
                      "table": "@{items('SQL_For_Each_Table')?['TABLE_NAME']}",
                      "error": "Failed to query columns, constraints, or indexes",
                      "timestamp": "@{utcNow()}"
                    }
                  },
                  "runAfter": {
                    "SQL_Build_Table_Object": [
                      "Failed",
                      "TimedOut"
                    ]
                  }
                }
              },
              "runAfter": {
                "SQL_Query_Tables": [
                  "Succeeded"
                ]
              },
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 5
                }
              }
            }
          }
        }
      },
      "default": {
        "actions": {
          "Unsupported_DbType_Response": {
            "type": "Response",
            "kind": "Http",
            "inputs": {
              "statusCode": 400,
              "headers": {
                "Content-Type": "application/json"
              },
              "body": {
                "error": "Unsupported sourceDbType. Must be 'Oracle' or 'SQLServer'.",
                "requestId": "@{triggerBody()?['requestId']}"
              }
            },
            "runAfter": {}
          }
        }
      },
      "runAfter": {
        "Get_Connection_String_From_KeyVault": [
          "Succeeded"
        ]
      }
    },
    "Build_Final_Result": {
      "type": "Compose",
      "inputs": {
        "requestId": "@{triggerBody()?['requestId']}",
        "sourceDbType": "@{triggerBody()?['sourceDbType']}",
        "schemaFilter": "@{triggerBody()?['schemaFilter']}",
        "status": "@{if(equals(length(variables('errorList')), 0), 'COMPLETED', 'COMPLETED_WITH_ERRORS')}",
        "tableCount": "@{length(variables('tableList'))}",
        "tables": "@variables('tableList')",
        "errors": "@variables('errorList')",
        "discoveredAt": "@{utcNow()}",
        "workflowRunId": "@{workflow()?['run']?['name']}"
      },
      "runAfter": {
        "Switch_On_DbType": [
          "Succeeded",
          "Failed"
        ]
      }
    },
    "Save_Discovery_To_Storage": {
      "type": "ApiConnection",
      "inputs": {
        "host": {
          "connection": {
            "name": "@parameters('$connections')['azureblob']['connectionId']"
          }
        },
        "method": "post",
        "path": "/v2/datasets/@{parameters('storageAccountName')}/files",
        "body": "@{outputs('Build_Final_Result')}",
        "headers": {
          "ReadFileMetadataFromServer": true
        },
        "queries": {
          "folderPath": "/@{parameters('storageContainerName')}",
          "name": "discovery-@{triggerBody()?['requestId']}-@{formatDateTime(utcNow(), 'yyyyMMdd-HHmmss')}.json",
          "queryParametersSingleEncoded": true
        }
      },
      "runAfter": {
        "Build_Final_Result": [
          "Succeeded"
        ]
      },
      "retryPolicy": {
        "type": "fixed",
        "count": 3,
        "interval": "PT10S"
      }
    },
    "Success_Response": {
      "type": "Response",
      "kind": "Http",
      "inputs": {
        "statusCode": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "@outputs('Build_Final_Result')"
      },
      "runAfter": {
        "Save_Discovery_To_Storage": [
          "Succeeded"
        ]
      }
    },
    "Error_Log_To_Storage": {
      "type": "ApiConnection",
      "inputs": {
        "host": {
          "connection": {
            "name": "@parameters('$connections')['azureblob']['connectionId']"
          }
        },
        "method": "post",
        "path": "/v2/datasets/@{parameters('storageAccountName')}/files",
        "body": {
          "requestId": "@{triggerBody()?['requestId']}",
          "status": "FAILED",
          "error": "Schema discovery workflow failed",
          "workflowRunId": "@{workflow()?['run']?['name']}",
          "timestamp": "@{utcNow()}"
        },
        "queries": {
          "folderPath": "/@{parameters('storageContainerName')}/errors",
          "name": "error-@{triggerBody()?['requestId']}-@{formatDateTime(utcNow(), 'yyyyMMdd-HHmmss')}.json",
          "queryParametersSingleEncoded": true
        }
      },
      "runAfter": {
        "Build_Final_Result": [
          "Failed",
          "TimedOut"
        ]
      }
    },
    "Error_Response": {
      "type": "Response",
      "kind": "Http",
      "inputs": {
        "statusCode": 500,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "requestId": "@{triggerBody()?['requestId']}",
          "status": "FAILED",
          "error": "Schema discovery failed. Check error logs in storage.",
          "workflowRunId": "@{workflow()?['run']?['name']}"
        }
      },
      "runAfter": {
        "Error_Log_To_Storage": [
          "Succeeded",
          "Failed"
        ]
      }
    }
  },
  "outputs": {}
}