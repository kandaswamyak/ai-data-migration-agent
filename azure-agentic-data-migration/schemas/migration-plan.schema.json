{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contoso.com/schemas/migration-plan.schema.json",
  "title": "Migration Plan",
  "description": "Schema for a migration plan generated by the AI agent after analysing source and target schemas. Contains table mappings, datatype conversions, risk assessments, DDL statements, and execution estimates.",
  "type": "object",
  "required": [
    "planId",
    "status",
    "sourceDetails",
    "targetDetails",
    "tableMappings",
    "overallRiskLevel",
    "estimatedRowCounts",
    "estimatedDuration",
    "ddlStatements",
    "createdAt",
    "createdBy"
  ],
  "properties": {
    "planId": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this migration plan."
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "ANALYZING",
        "AWAITING_APPROVAL",
        "APPROVED",
        "DRY_RUN",
        "READY_FOR_EXECUTION",
        "RUNNING",
        "COMPLETED",
        "FAILED",
        "CANCELLED",
        "VALIDATION_FAILED"
      ],
      "description": "Current lifecycle status of the plan."
    },
    "sourceDetails": {
      "type": "object",
      "description": "Source database connection and schema summary.",
      "required": ["sourceType", "host", "port", "database", "schema"],
      "properties": {
        "sourceType": {
          "type": "string",
          "enum": ["Oracle", "SQLServer"]
        },
        "host": { "type": "string" },
        "port": { "type": "integer" },
        "database": { "type": "string" },
        "schema": { "type": "string" },
        "version": {
          "type": "string",
          "description": "Detected source database version."
        },
        "characterSet": {
          "type": "string",
          "description": "Source character set (e.g. AL32UTF8)."
        }
      },
      "additionalProperties": false
    },
    "targetDetails": {
      "type": "object",
      "description": "Azure SQL Database target information.",
      "required": ["server", "database", "schema"],
      "properties": {
        "server": { "type": "string" },
        "database": { "type": "string" },
        "schema": { "type": "string" },
        "serviceTier": {
          "type": "string",
          "description": "Azure SQL service tier (e.g. S3, P1, GP_Gen5_2)."
        },
        "compatibilityLevel": {
          "type": "integer",
          "description": "SQL compatibility level."
        }
      },
      "additionalProperties": false
    },
    "tableMappings": {
      "type": "array",
      "description": "Per-table mapping details including column-level datatype conversions.",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sourceTable",
          "targetTable",
          "columns",
          "riskLevel",
          "estimatedRows"
        ],
        "properties": {
          "sourceTable": {
            "type": "string",
            "description": "Fully-qualified source table name."
          },
          "targetTable": {
            "type": "string",
            "description": "Fully-qualified target table name."
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "sourceColumn",
                "targetColumn",
                "sourceDatatype",
                "targetDatatype"
              ],
              "properties": {
                "sourceColumn": { "type": "string" },
                "targetColumn": { "type": "string" },
                "sourceDatatype": {
                  "type": "string",
                  "description": "Full datatype string from source (e.g. NUMBER(10,0), VARCHAR2(100))."
                },
                "targetDatatype": {
                  "type": "string",
                  "description": "Mapped Azure SQL datatype (e.g. BIGINT, NVARCHAR(100))."
                },
                "conversionNotes": {
                  "type": "string",
                  "description": "Agent notes about potential issues with this conversion."
                },
                "riskLevel": {
                  "type": "string",
                  "enum": ["LOW", "MEDIUM", "HIGH"],
                  "description": "Risk level for this specific column conversion."
                },
                "nullable": { "type": "boolean" },
                "isPrimaryKey": { "type": "boolean" },
                "defaultValue": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "riskLevel": {
            "type": "string",
            "enum": ["LOW", "MEDIUM", "HIGH"],
            "description": "Aggregate risk level for this table mapping."
          },
          "estimatedRows": {
            "type": "integer",
            "minimum": 0,
            "description": "Estimated row count from source."
          },
          "constraints": {
            "type": "array",
            "description": "Constraints to be created on the target table.",
            "items": {
              "type": "object",
              "properties": {
                "constraintName": { "type": "string" },
                "constraintType": {
                  "type": "string",
                  "enum": ["PRIMARY KEY", "FOREIGN KEY", "UNIQUE", "CHECK", "DEFAULT"]
                },
                "definition": { "type": "string" }
              },
              "required": ["constraintName", "constraintType", "definition"]
            }
          },
          "indexes": {
            "type": "array",
            "description": "Indexes to be created on the target table.",
            "items": {
              "type": "object",
              "properties": {
                "indexName": { "type": "string" },
                "columns": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "isUnique": { "type": "boolean" },
                "isClustered": { "type": "boolean" }
              },
              "required": ["indexName", "columns"]
            }
          },
          "migrationStrategy": {
            "type": "string",
            "enum": ["BULK_COPY", "BATCH_INSERT", "CHANGE_TRACKING"],
            "description": "Recommended data-movement strategy for this table."
          }
        },
        "additionalProperties": false
      }
    },
    "overallRiskLevel": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"],
      "description": "Highest risk level across all table mappings."
    },
    "estimatedRowCounts": {
      "type": "object",
      "description": "Map of table name to estimated row count.",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "estimatedDuration": {
      "type": "string",
      "description": "Human-readable estimated duration (e.g. '2h 30m').",
      "pattern": "^[0-9]+[dhms]( [0-9]+[dhms])*$"
    },
    "ddlStatements": {
      "type": "array",
      "description": "Ordered list of T-SQL DDL statements to prepare the target schema.",
      "items": {
        "type": "object",
        "required": ["order", "objectName", "objectType", "sql"],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "objectName": { "type": "string" },
          "objectType": {
            "type": "string",
            "enum": ["TABLE", "INDEX", "CONSTRAINT", "SEQUENCE", "VIEW", "PROCEDURE"]
          },
          "sql": {
            "type": "string",
            "description": "The T-SQL statement."
          },
          "dependsOn": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Object names this DDL depends on."
          }
        },
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "description": "Agent-generated warnings and recommendations.",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["INFO", "WARNING", "ERROR"]
          },
          "table": { "type": "string" },
          "column": { "type": "string" },
          "message": { "type": "string" }
        },
        "required": ["severity", "message"]
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp when the plan was generated."
    },
    "createdBy": {
      "type": "string",
      "description": "Identity of the agent or user who created this plan."
    },
    "approvedBy": {
      "type": "string",
      "description": "Identity of the approver (populated after approval)."
    },
    "approvedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
